{
  "id": "web-extract",
  "name": "Web Extract",
  "description": "Expose clean webpage extraction tools for OpenClaw agents.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "defaults": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxChars": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 120000
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 3000,
            "maximum": 120000
          },
          "playwrightFallback": {
            "type": "boolean"
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "debug": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
